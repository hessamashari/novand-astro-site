---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/ui/Icon.astro';
const projects=await getCollection('projects');
---
<SiteLayout title="Projects — Novand" description="A future-ready project architecture for Novand case studies, with placeholders clearly marked until verified project information is available." >
<section class="bg-black-950 text-black-50 py-20 lg:py-28"><div class="container-wide"><p class="eyebrow text-white/45">Projects / 01</p><h1 class="h1 mt-6 max-w-5xl">An editorial structure ready for real case studies.</h1><p class="body-lg mt-7 max-w-3xl text-white/65">No clients, results, certifications, or project claims are invented here. The current entries are explicitly illustrative placeholders.</p></div></section>
<section class="bg-almond-50 text-black-950 py-20 lg:py-28"><div class="container-wide grid gap-5 md:grid-cols-2">{projects.map((p)=><a href={`/projects/${p.id}`} class="group min-h-80 border border-black-950/15 p-6 hover:bg-black-950 hover:text-white transition-colors"><div class="flex items-start justify-between gap-5"><span class="eyebrow text-black-950/45 group-hover:text-white/45">Illustrative placeholder</span><Icon name="arrow" class="size-4 group-hover:translate-x-1 transition-transform"/></div><h2 class="h3 mt-20">{p.data.title}</h2><p class="mt-3 text-sm leading-6 text-black-950/60 group-hover:text-white/55">{p.data.summary}</p></a>)}</div></section>
</SiteLayout>
