---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { company } from '../data/site';
---
<SiteLayout
  title="Request a Consultation & Contact — Novand"
  description="Connect with Novand's engineering team for technology infrastructure design, enterprise networking, security surveillance, smart automation, or technical advisory."
  light
>
<section class="bg-khaki-50 text-black-950 py-20 lg:py-28">
  <div class="container-wide">
    <p class="eyebrow text-black-950/45">Contact / 01</p>
    <h1 class="h1 mt-6 max-w-5xl">Tell us about the environment you are building.</h1>
    <p class="body-lg mt-7 max-w-3xl text-black-950/65">Share the system, the constraints, and what needs to change. Connect with our engineering advisors for architecture, implementation, and equipment guidance.</p>
  </div>
</section>

<section class="bg-black-950 text-black-50 py-20 lg:py-28">
  <div class="container-wide grid gap-14 lg:grid-cols-[.75fr_1.25fr]">
    <aside id="contact-details-aside">
      <p class="eyebrow text-white/40">Direct Contact</p>
      <div class="mt-7 grid gap-5 text-sm">
        <div>
          <p class="text-white/40">Business email</p>
          <p class="mt-1"><a href={`mailto:${company.email}`} class="hover:underline text-white/90">{company.email}</a></p>
        </div>
        <div>
          <p class="text-white/40">Direct line</p>
          <p class="mt-1"><a href={`tel:${company.phone.replace(/[^+\d]/g, '')}`} class="hover:underline text-white/90">{company.phone}</a></p>
        </div>
        <div>
          <p class="text-white/40">Service Scope</p>
          <p class="mt-1 text-white/90">{company.address}</p>
        </div>
        <div>
          <p class="text-white/40">Engineering & Support Hours</p>
          <p class="mt-1 text-white/90">{company.hours}</p>
        </div>
      </div>

      <!-- Architectural Deployment Visual -->
      <div class="mt-10 border border-white/12 bg-jet-950 p-6 relative overflow-hidden" aria-label="Deployment coverage map">
        <div class="flex items-center justify-between border-b border-white/10 pb-3 text-[0.65rem] uppercase tracking-[0.16em] text-white/40">
          <span>Operational Footprint</span>
          <span class="inline-flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Active</span>
        </div>
        <div class="py-6 grid grid-cols-3 gap-2 text-center text-xs">
          <div class="border border-white/10 p-3 bg-white/[0.02]">
            <p class="text-[0.6rem] uppercase tracking-wider text-white/40">Field</p>
            <p class="mt-1 font-semibold text-white/90">On-Site</p>
          </div>
          <div class="border border-white/10 p-3 bg-white/[0.02]">
            <p class="text-[0.6rem] uppercase tracking-wider text-white/40">Network</p>
            <p class="mt-1 font-semibold text-white/90">Multi-Site</p>
          </div>
          <div class="border border-white/10 p-3 bg-white/[0.02]">
            <p class="text-[0.6rem] uppercase tracking-wider text-white/40">Systems</p>
            <p class="mt-1 font-semibold text-white/90">Turnkey</p>
          </div>
        </div>
        <p class="text-xs text-white/50 leading-relaxed border-t border-white/10 pt-3">
          On-site deployments, structured cabling inspections, rack integration, and remote operations management across primary regions.
        </p>
      </div>
    </aside>

    <div id="contact-form-container">
      <div id="form-success-banner" class="hidden border border-white/20 bg-white/[0.03] p-8 text-left">
        <div class="flex items-center gap-3">
          <span class="size-2 rounded-full bg-emerald-400"></span>
          <p class="eyebrow text-emerald-400">Consultation Request Received</p>
        </div>
        <h3 class="h3 mt-4 text-white">Thank you for outlining your environment.</h3>
        <p class="mt-4 text-sm leading-6 text-white/70">
          Our engineering team has received your project parameters. A technical advisor will review the constraints and follow up within one business day with relevant scoping details.
        </p>
        <div class="mt-6 border-t border-white/10 pt-4 flex flex-wrap gap-4 items-center justify-between text-xs text-white/60">
          <span id="ticket-reference-text">Reference: NOV-8201</span>
          <button id="reset-form-btn" type="button" class="underline hover:text-white transition-colors">
            Submit another inquiry
          </button>
        </div>
      </div>

      <form id="consultation-form" class="grid gap-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm">
            <span>Name <span class="text-white/40">*</span></span>
            <input id="input-name" required name="name" autocomplete="name" placeholder="Full name or lead engineer" class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60 text-white" />
          </label>
          <label class="grid gap-2 text-sm">
            <span>Company / Organization</span>
            <input id="input-company" name="company" autocomplete="organization" placeholder="Facility or business name" class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60 text-white" />
          </label>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm">
            <span>Email <span class="text-white/40">*</span></span>
            <input id="input-email" required type="email" name="email" autocomplete="email" placeholder="contact@domain.com" class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60 text-white" />
          </label>
          <label class="grid gap-2 text-sm">
            <span>Phone</span>
            <input id="input-phone" name="phone" autocomplete="tel" placeholder="+1 (555) 000-0000" class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60 text-white" />
          </label>
        </div>

        <label class="grid gap-2 text-sm">
          <span>Primary Discipline / Focus</span>
          <select id="select-project-type" name="project-type" class="min-h-12 border border-white/15 bg-jet-950 px-4 outline-none focus:border-white/60 text-white">
            <option value="network-infrastructure">Network Infrastructure & IT</option>
            <option value="enterprise-services">Enterprise & Network Services</option>
            <option value="infrastructure-administration">Linux & Infrastructure Administration</option>
            <option value="smart-homes-buildings">Smart Homes & Buildings Automation</option>
            <option value="security-surveillance">Security & Surveillance (CCTV / Access)</option>
            <option value="audio-power">Audio, Power & Integrated Systems</option>
            <option value="hardware-support">Hardware & Equipment Procurement Consulting</option>
            <option value="other">Multi-Layer / Other Facility Integration</option>
          </select>
        </label>

        <label class="grid gap-2 text-sm">
          <span>Project & System Constraints <span class="text-white/40">*</span></span>
          <textarea id="input-message" required name="message" rows="6" placeholder="Describe the physical space, existing hardware, reliability issues, or specific objectives..." class="border border-white/15 bg-white/[.03] p-4 outline-none focus:border-white/60 text-white leading-relaxed"></textarea>
        </label>

        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between pt-2">
          <p class="text-xs leading-5 text-white/40 max-w-sm">
            Direct communications are kept confidential and handled strictly by Novand systems engineers.
          </p>
          <button id="submit-request-button" type="submit" class="inline-flex shrink-0 items-center justify-center gap-3 border border-white/70 px-6 py-3.5 text-sm font-semibold hover:bg-white hover:text-black-950 transition-colors">
            <span>Send Request</span>
            <Icon name="arrow" class="size-4" />
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('consultation-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('form-success-banner');
  const resetBtn = document.getElementById('reset-form-btn');
  const submitBtn = document.getElementById('submit-request-button');
  const refText = document.getElementById('ticket-reference-text');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form || !successBanner) return;

    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = 'Transmitting...';
    }

    setTimeout(() => {
      const randomRef = 'NOV-' + Math.floor(1000 + Math.random() * 9000);
      if (refText) {
        refText.textContent = `Inquiry Reference: ${randomRef}`;
      }
      form.classList.add('hidden');
      successBanner.classList.remove('hidden');

      if (submitBtn) {
        submitBtn.removeAttribute('disabled');
        submitBtn.innerHTML = '<span>Send Request</span>';
      }
    }, 450);
  });

  resetBtn?.addEventListener('click', () => {
    if (!form || !successBanner) return;
    form.reset();
    successBanner.classList.add('hidden');
    form.classList.remove('hidden');
  });
</script>
</SiteLayout>
