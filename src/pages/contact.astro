---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { company } from '../data/site';
---
<SiteLayout title="Contact — Novand" description="Request a consultation with Novand for technology infrastructure, networking, security, automation, and smart systems." light>
<section class="bg-khaki-50 text-black-950 py-20 lg:py-28"><div class="container-wide"><p class="eyebrow text-black-950/45">Contact / 01</p><h1 class="h1 mt-6 max-w-5xl">Tell us about the environment you are building.</h1><p class="body-lg mt-7 max-w-3xl text-black-950/65">Share the system, the constraints, and what needs to change. This form is intentionally provider-ready rather than connected to a fake backend.</p></div></section>
<section class="bg-black-950 text-black-50 py-20 lg:py-28"><div class="container-wide grid gap-14 lg:grid-cols-[.7fr_1.3fr]"><aside><p class="eyebrow text-white/40">Contact information</p><div class="mt-7 grid gap-5 text-sm"><div><p class="text-white/40">Business email</p><p class="mt-1">{company.email}</p></div><div><p class="text-white/40">Phone</p><p class="mt-1">{company.phone}</p></div><div><p class="text-white/40">Address</p><p class="mt-1">{company.address}</p></div><div><p class="text-white/40">Working hours</p><p class="mt-1">{company.hours}</p></div></div><div class="mt-10 aspect-video border border-white/12 grid place-items-center text-xs uppercase tracking-[.16em] text-white/30">Map placeholder</div></aside><form class="grid gap-5" action="#" method="post"><div class="grid gap-5 sm:grid-cols-2"><label class="grid gap-2 text-sm"><span>Name</span><input required name="name" autocomplete="name" class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60" /></label><label class="grid gap-2 text-sm"><span>Company / Organization</span><input name="company" autocomplete="organization" class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60" /></label></div><div class="grid gap-5 sm:grid-cols-2"><label class="grid gap-2 text-sm"><span>Email</span><input required type="email" name="email" autocomplete="email" class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60" /></label><label class="grid gap-2 text-sm"><span>Phone</span><input name="phone" autocomplete="tel" class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60" /></label></div><label class="grid gap-2 text-sm"><span>Project Type</span><select name="project-type" class="min-h-12 border border-white/15 bg-jet-950 px-4 outline-none focus:border-white/60"><option>Networking & Infrastructure</option><option>Enterprise Services</option><option>Infrastructure Administration</option><option>Smart Homes & Buildings</option><option>Security & Surveillance</option><option>Audio, Power & Integrated Systems</option><option>Hardware & Technical Support</option><option>Other</option></select></label><label class="grid gap-2 text-sm"><span>Message</span><textarea required name="message" rows="7" class="border border-white/15 bg-white/[.03] p-4 outline-none focus:border-white/60"></textarea></label><div class="flex items-center justify-between gap-5"><p class="text-xs leading-5 text-white/40">Submission wiring should be connected to a real form provider/API before launch.</p><button type="submit" class="inline-flex shrink-0 items-center gap-3 border border-white/70 px-5 py-3.5 text-sm font-semibold hover:bg-white hover:text-black-950 transition-colors">Send Request <Icon name="arrow" class="size-4" /></button></div></form></div>
</section>
</SiteLayout>
