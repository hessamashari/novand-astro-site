---
import { getCollection, getEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { path } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const relatedEntries = await Promise.all(entry.data.related.filter((slug) => slug !== 'consulting').map((slug) => getEntry('services', slug)));

const serviceSchema = {
  '@type': 'Service',
  name: entry.data.title,
  serviceType: entry.data.eyebrow,
  description: entry.data.description,
  provider: {
    '@type': 'Organization',
    name: 'Novand',
  },
  areaServed: 'Commercial, Residential & Specialized Facilities',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: entry.data.title,
    itemListElement: entry.data.capabilities.map((cap) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: cap,
      },
    })),
  },
};
---
<SiteLayout
  title={`${entry.data.title} — Novand Services`}
  description={entry.data.description}
  section="Engineering Services"
  tags={entry.data.capabilities}
  jsonLd={serviceSchema}
  light
>
<section class={`py-20 lg:py-28 ${entry.data.accent === 'warm' ? 'bg-almond-50' : 'bg-khaki-50'} text-black-950`}><div class="container-wide"><a href={path('/services')} class="eyebrow text-black-950/45 hover:text-black-950">Services / Catalog</a><div class="mt-10 grid gap-10 lg:grid-cols-[1fr_.72fr] lg:items-end"><div><p class="eyebrow text-black-950/45">{entry.data.eyebrow}</p><h1 class="h1 mt-6 max-w-5xl">{entry.data.title}</h1></div><p class="body-lg text-black-950/65">{entry.data.description}</p></div></div></section>
<section class="bg-black-950 text-black-50 py-20 lg:py-28"><div class="container-wide grid gap-14 lg:grid-cols-[1fr_1.2fr]"><div><p class="eyebrow text-white/40">Introduction / 01</p><p class="mt-6 text-2xl tracking-tight leading-tight max-w-lg">{entry.data.intro}</p></div><div><p class="eyebrow text-white/40">What we provide / 02</p><div class="mt-6 divide-y divide-white/10 border-y border-white/10">{entry.data.capabilities.map((item,index)=><div class="flex items-center justify-between gap-8 py-5"><span>{item}</span><span class="eyebrow text-white/30">{String(index+1).padStart(2,'0')}</span></div>)}</div></div></div></section>
<section class="bg-khaki-50 text-black-950 py-20 lg:py-28"><div class="container-wide grid gap-14 lg:grid-cols-2"><div><p class="eyebrow text-black-950/45">Applications / 03</p><h2 class="h2 mt-5">Where this service fits.</h2></div><div class="grid gap-3 sm:grid-cols-2">{entry.data.environments.map((e)=><div class="border border-black-950/15 p-5 text-sm">{e}</div>)}</div></div></section>
<section class="bg-jet-950 text-black-50 py-20"><div class="container-wide"><p class="eyebrow text-white/40">Related services / 04</p><div class="mt-7 grid gap-3 md:grid-cols-2">{relatedEntries.filter(Boolean).map((r)=><a href={path(`/services/${r.id}`)} class="group flex items-center justify-between border border-white/12 px-5 py-4"><span class="text-sm">{r.data.title}</span><Icon name="arrow" class="size-4 text-white/40 group-hover:translate-x-1 transition-transform"/></a>)}</div></div></section>
<section class="bg-black-950 text-black-50 py-16"><div class="container-wide flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"><div><p class="eyebrow text-white/40">Next step</p><h2 class="mt-3 text-2xl font-semibold">Discuss this service in the context of your project.</h2></div><a href={path('/contact')} class="inline-flex items-center gap-3 border border-white/25 px-5 py-3.5 text-sm font-semibold hover:border-white/70">Request a Consultation <Icon name="arrow" class="size-4"/></a></div></section>
</SiteLayout>
