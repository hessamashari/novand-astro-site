---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionIntro from '../components/sections/SectionIntro.astro';
import Icon from '../components/ui/Icon.astro';
---
<SiteLayout title="About — Novand" description="About Novand and its integrated approach to technology infrastructure and systems engineering." light>
<section class="bg-khaki-50 text-black-950 py-20 lg:py-28"><div class="container-wide"><p class="eyebrow text-black-950/45">About / 01</p><h1 class="h1 mt-6 max-w-5xl">An engineering partner for systems that need to work together.</h1><p class="body-lg mt-8 max-w-3xl text-black-950/65">Novand provides the design, implementation, configuration, and support of integrated technology infrastructure across networking, security, automation, smart environments, and related systems.</p></div></section>
<section class="bg-black-950 text-black-50 py-20 lg:py-28"><div class="container-wide grid gap-12 lg:grid-cols-2 lg:items-start"><SectionIntro eyebrow="Positioning / 02" title="From disconnected technologies to a coherent environment" body="The company is positioned around integration: the technical layers should complement each other, be documented, and remain understandable to the people who operate them."/><div class="border border-white/12 p-7"><div class="grid gap-4">{['Infrastructure','Network','Security','Automation','Smart Technology','Support'].map((x,i)=><div class="flex items-center justify-between border-b border-white/10 py-4 last:border-0"><span class="text-sm">{x}</span><span class="eyebrow text-white/35">0{i+1}</span></div>)}</div></div></div></section>
<section class="bg-almond-50 text-black-950 py-20 lg:py-28"><div class="container-wide"><SectionIntro eyebrow="Principles / 03" title="Precision without theater" body="The visual and editorial language deliberately avoids generic corporate claims. The focus stays on architecture, reliability, security, integration, and practical delivery." light/><div class="mt-12 grid gap-4 md:grid-cols-3"><div class="border border-black-950/15 p-6"><p class="eyebrow">01</p><h3 class="mt-14 h3">Technical clarity</h3><p class="mt-4 text-sm leading-6 text-black-950/60">Prefer direct language, explicit boundaries, and useful documentation.</p></div><div class="border border-black-950/15 p-6"><p class="eyebrow">02</p><h3 class="mt-14 h3">System thinking</h3><p class="mt-4 text-sm leading-6 text-black-950/60">Consider dependencies between infrastructure, security, automation, and use.</p></div><div class="border border-black-950/15 p-6"><p class="eyebrow">03</p><h3 class="mt-14 h3">Long-term support</h3><p class="mt-4 text-sm leading-6 text-black-950/60">A successful implementation should still make sense after handover.</p></div></div></div></section>
<section class="bg-black-950 text-black-50 py-20"><div class="container-wide flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"><div><p class="eyebrow text-white/45">Next</p><h2 class="h2 mt-4">Explore the service architecture.</h2></div><a href="/services" class="inline-flex items-center gap-3 text-sm font-semibold">View services <Icon name="arrow" class="size-4" /></a></div></section>
</SiteLayout>
