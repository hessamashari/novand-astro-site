---
import Icon from '../ui/Icon.astro';

interface Props {
  formId?: string;
  sourcePage?: string;
  subject?: string;
  defaultProjectType?: string;
}

const {
  formId = 'consultation-form',
  sourcePage = 'Contact & Consultation',
  subject = 'New Consultation & Engineering Inquiry — Novand',
  defaultProjectType = 'network-infrastructure',
} = Astro.props;

const FORMSPREE_FORM_ID = 'xgaenjbn';
const FORMSPREE_ENDPOINT = `https://formspree.io/f/${FORMSPREE_FORM_ID}`;
---

<div id={`${formId}-wrapper`} class="w-full">
  <!-- Success Banner (Formspree success state) -->
  <div
    id={`${formId}-success`}
    data-fs-success
    class="hidden border border-emerald-500/30 bg-emerald-950/20 p-8 text-left"
    role="status"
    aria-live="polite"
  >
    <div class="flex items-center gap-3">
      <span class="size-2 rounded-full bg-emerald-400"></span>
      <p class="eyebrow text-emerald-400">Consultation Request Received</p>
    </div>
    <h3 class="h3 mt-4 text-white">Thank you for outlining your environment.</h3>
    <p class="mt-4 text-sm leading-6 text-white/70">
      Your inquiry has been successfully transmitted via our Formspree gateway to Novand's engineering team. A technical advisor will review the system constraints and follow up within one business day with relevant scoping details.
    </p>
    <div class="mt-6 border-t border-white/10 pt-4 flex flex-wrap gap-4 items-center justify-between text-xs text-white/60">
      <span id={`${formId}-ref`} class="font-mono text-emerald-300">Reference: NOV-8201</span>
      <button
        id={`${formId}-reset`}
        type="button"
        class="underline hover:text-white transition-colors cursor-pointer"
      >
        Submit another inquiry
      </button>
    </div>
  </div>

  <!-- Form -->
  <form
    id={formId}
    action={FORMSPREE_ENDPOINT}
    method="POST"
    class="grid gap-5"
    data-form-id={FORMSPREE_FORM_ID}
  >
    <!-- Hidden Formspree Metadata -->
    <input type="hidden" name="_subject" value={subject} />
    <input type="hidden" name="source_page" value={sourcePage} />
    <!-- Honeypot anti-spam field -->
    <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

    <!-- Form-level error banner -->
    <div
      id={`${formId}-error-banner`}
      data-fs-error
      class="hidden border border-rose-500/40 bg-rose-950/25 p-4 text-xs text-rose-300 leading-relaxed"
      role="alert"
    >
      An error occurred while transmitting your request. Please verify the required fields below or email us directly at <a href="mailto:novand.info@gmail.com" class="underline text-white font-medium">novand.info@gmail.com</a>.
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <label class="grid gap-2 text-sm">
        <span>Name <span class="text-white/40">*</span></span>
        <input
          id={`${formId}-name`}
          required
          name="name"
          autocomplete="name"
          placeholder="Full name or lead engineer"
          data-fs-field
          class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60 text-white transition-colors"
        />
        <span data-fs-error="name" class="hidden text-xs text-rose-400 mt-1"></span>
      </label>
      <label class="grid gap-2 text-sm">
        <span>Company / Organization</span>
        <input
          id={`${formId}-company`}
          name="company"
          autocomplete="organization"
          placeholder="Facility or business name"
          data-fs-field
          class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60 text-white transition-colors"
        />
        <span data-fs-error="company" class="hidden text-xs text-rose-400 mt-1"></span>
      </label>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <label class="grid gap-2 text-sm">
        <span>Email <span class="text-white/40">*</span></span>
        <input
          id={`${formId}-email`}
          required
          type="email"
          name="email"
          autocomplete="email"
          placeholder="contact@domain.com"
          data-fs-field
          class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60 text-white transition-colors"
        />
        <span data-fs-error="email" class="hidden text-xs text-rose-400 mt-1"></span>
      </label>
      <label class="grid gap-2 text-sm">
        <span>Phone</span>
        <input
          id={`${formId}-phone`}
          name="phone"
          type="tel"
          autocomplete="tel"
          placeholder="+1 (555) 000-0000"
          data-fs-field
          class="min-h-12 border border-white/15 bg-white/[.03] px-4 outline-none focus:border-white/60 text-white transition-colors"
        />
        <span data-fs-error="phone" class="hidden text-xs text-rose-400 mt-1"></span>
      </label>
    </div>

    <label class="grid gap-2 text-sm">
      <span>Primary Discipline / Focus</span>
      <select
        id={`${formId}-project-type`}
        name="project-type"
        data-fs-field
        class="min-h-12 border border-white/15 bg-jet-950 px-4 outline-none focus:border-white/60 text-white transition-colors"
      >
        <option value="network-infrastructure" selected={defaultProjectType === 'network-infrastructure'}>Network Infrastructure &amp; IT</option>
        <option value="enterprise-services" selected={defaultProjectType === 'enterprise-services'}>Enterprise &amp; Network Services</option>
        <option value="infrastructure-administration" selected={defaultProjectType === 'infrastructure-administration'}>Linux &amp; Infrastructure Administration</option>
        <option value="smart-homes-buildings" selected={defaultProjectType === 'smart-homes-buildings'}>Smart Homes &amp; Buildings Automation</option>
        <option value="security-surveillance" selected={defaultProjectType === 'security-surveillance'}>Security &amp; Surveillance (CCTV / Access)</option>
        <option value="audio-power" selected={defaultProjectType === 'audio-power'}>Audio, Power &amp; Integrated Systems</option>
        <option value="hardware-support" selected={defaultProjectType === 'hardware-support'}>Hardware &amp; Equipment Procurement Advisory</option>
        <option value="other" selected={defaultProjectType === 'other'}>Multi-Layer / Other Facility Integration</option>
      </select>
    </label>

    <label class="grid gap-2 text-sm">
      <span>Project &amp; System Constraints <span class="text-white/40">*</span></span>
      <textarea
        id={`${formId}-message`}
        required
        name="message"
        rows="6"
        placeholder="Describe the physical space, existing hardware, reliability issues, or specific objectives..."
        data-fs-field
        class="border border-white/15 bg-white/[.03] p-4 outline-none focus:border-white/60 text-white leading-relaxed transition-colors"
      ></textarea>
      <span data-fs-error="message" class="hidden text-xs text-rose-400 mt-1"></span>
    </label>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between pt-2">
      <p class="text-xs leading-5 text-white/40 max-w-sm">
        Inquiries are routed directly to Novand systems engineers via Formspree. Details remain confidential.
      </p>
      <button
        id={`${formId}-submit-btn`}
        type="submit"
        data-fs-submit-btn
        class="inline-flex shrink-0 items-center justify-center gap-3 border border-white/70 px-6 py-3.5 text-sm font-semibold hover:bg-white hover:text-black-950 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span class="btn-text">Send Request</span>
        <Icon name="arrow" class="size-4" />
      </button>
    </div>
  </form>
</div>

<style>
  [data-fs-error][data-fs-active] {
    display: block !important;
  }
  [data-fs-field][aria-invalid="true"] {
    border-color: rgba(244, 63, 94, 0.8) !important;
  }
</style>

<script>
  import { initForm } from '@formspree/ajax';

  function setupForm(formElement: HTMLFormElement) {
    const formId = formElement.id;
    const successBanner = document.getElementById(`${formId}-success`);
    const errorBanner = document.getElementById(`${formId}-error-banner`);
    const resetBtn = document.getElementById(`${formId}-reset`);
    const submitBtn = document.getElementById(`${formId}-submit-btn`);
    const refText = document.getElementById(`${formId}-ref`);

    if (!formElement || !successBanner) return;

    const endpointId = formElement.dataset.formId || 'xgaenjbn';

    try {
      initForm({
        formElement: formElement,
        formId: endpointId,
        useDefaultStyles: false,
        onSubmit: () => {
          if (errorBanner) errorBanner.classList.add('hidden');
          if (submitBtn) {
            const btnText = submitBtn.querySelector('.btn-text');
            if (btnText) btnText.textContent = 'Transmitting...';
          }
        },
        onSuccess: () => {
          const randomRef = 'NOV-' + Math.floor(1000 + Math.random() * 9000);
          if (refText) {
            refText.textContent = `Inquiry Reference: ${randomRef}`;
          }
          formElement.classList.add('hidden');
          successBanner.classList.remove('hidden');

          if (submitBtn) {
            const btnText = submitBtn.querySelector('.btn-text');
            if (btnText) btnText.textContent = 'Send Request';
          }
        },
        onError: (_context, error) => {
          if (errorBanner) {
            errorBanner.classList.remove('hidden');
            const formErrors = error.getFormErrors();
            if (formErrors.length > 0) {
              errorBanner.textContent = formErrors.map((e: { message: string }) => e.message).join(' ');
            }
          }
          if (submitBtn) {
            const btnText = submitBtn.querySelector('.btn-text');
            if (btnText) btnText.textContent = 'Send Request';
          }
        },
        onFailure: () => {
          if (errorBanner) {
            errorBanner.classList.remove('hidden');
            errorBanner.textContent = 'Network transmission error. Please check your internet connection or email us directly.';
          }
          if (submitBtn) {
            const btnText = submitBtn.querySelector('.btn-text');
            if (btnText) btnText.textContent = 'Send Request';
          }
        }
      });
    } catch (err) {
      console.warn('Falling back to standard fetch handler:', err);
      formElement.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          const btnText = submitBtn.querySelector('.btn-text');
          if (btnText) btnText.textContent = 'Transmitting...';
        }
        if (errorBanner) errorBanner.classList.add('hidden');

        try {
          const formData = new FormData(formElement);
          const response = await fetch(`https://formspree.io/f/${endpointId}`, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          if (response.ok) {
            const randomRef = 'NOV-' + Math.floor(1000 + Math.random() * 9000);
            if (refText) refText.textContent = `Inquiry Reference: ${randomRef}`;
            formElement.classList.add('hidden');
            successBanner.classList.remove('hidden');
          } else {
            const data = await response.json().catch(() => ({}));
            if (errorBanner) {
              errorBanner.classList.remove('hidden');
              if (data.errors && data.errors.length) {
                errorBanner.textContent = data.errors.map((x: { message: string }) => x.message).join(', ');
              }
            }
          }
        } catch {
          if (errorBanner) {
            errorBanner.classList.remove('hidden');
            errorBanner.textContent = 'Network error. Please try again or email us directly.';
          }
        } finally {
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            const btnText = submitBtn.querySelector('.btn-text');
            if (btnText) btnText.textContent = 'Send Request';
          }
        }
      });
    }

    resetBtn?.addEventListener('click', () => {
      formElement.reset();
      successBanner.classList.add('hidden');
      if (errorBanner) errorBanner.classList.add('hidden');
      formElement.classList.remove('hidden');
    });
  }

  // Initialize each form on the page
  document.querySelectorAll<HTMLFormElement>('form[data-form-id]').forEach((form) => {
    setupForm(form);
  });
</script>
