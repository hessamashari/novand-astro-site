---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import { navigation, path } from '../../data/site';

interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;
const tone = light ? 'text-black-950 border-black-950/15' : 'text-black-50 border-black-50/15';
const dropdownBoxClass = light
  ? 'bg-khaki-50 text-black-950 border border-black-950/20 shadow-2xl'
  : 'bg-black-950 text-black-50 border border-white/20 shadow-2xl';
const dropdownItemClass = light
  ? 'border border-black-950/15 p-3 text-xs font-medium leading-tight hover:bg-black-950/5 transition-colors block text-black-950'
  : 'border border-white/10 p-3 text-xs font-medium leading-tight hover:bg-white/5 transition-colors block text-black-50';
const dropdownFooterClass = light
  ? 'border-t border-black-950/15 pt-3 mt-3 text-xs font-semibold text-black-950/75 hover:text-black-950 flex items-center justify-between'
  : 'border-t border-white/10 pt-3 mt-3 text-xs font-semibold text-white/70 hover:text-white flex items-center justify-between';
---
<header id="site-header" class={`sticky top-0 z-50 border-b backdrop-blur-xl bg-black-950/85 ${light ? 'bg-khaki-50/90' : ''} ${tone}`}>
  <div class="container-wide flex h-[4.5rem] items-center justify-between gap-4">
    <Logo />
    <nav id="primary-navigation" class="hidden lg:flex items-center gap-7 text-sm" aria-label="Primary navigation">
      <a href={path('/')} class="hover:opacity-60 transition-opacity">Home</a>
      <a href={path('/about')} class="hover:opacity-60 transition-opacity">About</a>
      
      <details id="services-dropdown" class="group relative header-details">
        <summary class="list-none flex cursor-pointer items-center gap-1.5 hover:opacity-60 [&::-webkit-details-marker]:hidden font-medium">
          Services <span aria-hidden="true" class="text-xs transition-transform group-open:rotate-180">⌄</span>
        </summary>
        <div class={`absolute left-1/2 top-full mt-3 w-[36rem] -translate-x-1/2 p-5 ${dropdownBoxClass}`}>
          <div class="grid grid-cols-2 gap-2">
            {navigation.services.map((item) => (
              <a href={item.href} class={dropdownItemClass}>{item.label}</a>
            ))}
          </div>
          <a href={path('/services')} class={dropdownFooterClass}>
            <span>Browse Full Services Catalog</span>
            <Icon name="arrow" class="size-3.5" />
          </a>
        </div>
      </details>

      <details id="solutions-dropdown" class="group relative header-details">
        <summary class="list-none flex cursor-pointer items-center gap-1.5 hover:opacity-60 [&::-webkit-details-marker]:hidden font-medium">
          Solutions <span aria-hidden="true" class="text-xs transition-transform group-open:rotate-180">⌄</span>
        </summary>
        <div class={`absolute left-1/2 top-full mt-3 w-84 -translate-x-1/2 p-5 ${dropdownBoxClass}`}>
          <div class="grid gap-2">
            {navigation.solutions.map((item) => (
              <a href={item.href} class={dropdownItemClass}>{item.label}</a>
            ))}
          </div>
          <a href={path('/solutions')} class={dropdownFooterClass}>
            <span>Explore All Environments</span>
            <Icon name="arrow" class="size-3.5" />
          </a>
        </div>
      </details>

      <a href={path('/projects')} class="hover:opacity-60 transition-opacity">Projects</a>
      <a href={path('/consulting')} class="hover:opacity-60 transition-opacity">Consulting</a>
      <a href={path('/contact')} class="hover:opacity-60 transition-opacity">Contact</a>
    </nav>
    <div class="flex items-center gap-2">
      <a id="header-cta-button" href={path('/contact')} class="hidden sm:inline-flex items-center gap-3 border border-current/25 px-4 py-2.5 text-sm font-semibold hover:bg-white/5 transition-colors">
        Request a Consultation <Icon name="arrow" class="size-4" />
      </a>
      <button id="menu-toggle" type="button" class="lg:hidden grid size-11 place-items-center border border-current/20" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>
  
  <div id="mobile-menu" class={`hidden lg:hidden border-t border-current/15 ${light ? 'bg-khaki-50 text-black-950' : 'bg-black-950 text-black-50'}`} aria-hidden="true">
    <div class="container-wide py-5 grid gap-2 text-sm">
      <a href={path('/')} class="px-2 py-2.5 border-b border-current/10 font-medium">Home</a>
      <a href={path('/about')} class="px-2 py-2.5 border-b border-current/10 font-medium">About</a>
      
      <details class="border-b border-current/10 py-1">
        <summary class="px-2 py-2 cursor-pointer font-medium flex justify-between items-center list-none [&::-webkit-details-marker]:hidden">
          <span>Services ({navigation.services.length})</span>
          <span aria-hidden="true" class="text-xs">⌄</span>
        </summary>
        <div class="grid gap-1.5 pl-4 pr-2 py-2 text-xs">
          {navigation.services.map((item) => (
            <a href={item.href} class="py-1.5 opacity-80 hover:opacity-100">{item.label}</a>
          ))}
          <a href={path('/services')} class="py-1.5 font-semibold text-xs mt-1 underline">All Services Catalog →</a>
        </div>
      </details>

      <details class="border-b border-current/10 py-1">
        <summary class="px-2 py-2 cursor-pointer font-medium flex justify-between items-center list-none [&::-webkit-details-marker]:hidden">
          <span>Solutions ({navigation.solutions.length})</span>
          <span aria-hidden="true" class="text-xs">⌄</span>
        </summary>
        <div class="grid gap-1.5 pl-4 pr-2 py-2 text-xs">
          {navigation.solutions.map((item) => (
            <a href={item.href} class="py-1.5 opacity-80 hover:opacity-100">{item.label}</a>
          ))}
          <a href={path('/solutions')} class="py-1.5 font-semibold text-xs mt-1 underline">All Solutions →</a>
        </div>
      </details>

      <a href={path('/projects')} class="px-2 py-2.5 border-b border-current/10 font-medium">Projects</a>
      <a href={path('/consulting')} class="px-2 py-2.5 border-b border-current/10 font-medium">Consulting</a>
      <a href={path('/contact')} class="px-2 py-2.5 border-b border-current/10 font-medium">Contact</a>
      
      <a href={path('/contact')} class="mt-4 inline-flex items-center justify-between border border-current/30 px-4 py-3 font-semibold">
        <span>Request a Consultation</span>
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </div>
</header>
<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    if (!menu || !toggle) return;
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    menu.classList.toggle('hidden', open);
    menu.setAttribute('aria-hidden', String(open));
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;
    const detailsList = document.querySelectorAll<HTMLDetailsElement>('header details.header-details[open]');
    detailsList.forEach((detail) => {
      if (!detail.contains(target)) {
        detail.removeAttribute('open');
      }
    });
  });

  // Close dropdowns on Escape key
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      const detailsList = document.querySelectorAll<HTMLDetailsElement>('header details[open]');
      detailsList.forEach((detail) => detail.removeAttribute('open'));
    }
  });
</script>
