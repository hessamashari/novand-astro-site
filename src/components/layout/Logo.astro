---
import { path } from '../../data/site';

interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg' | number;
  showText?: boolean;
  textClass?: string;
  id?: string;
}

const {
  class: className = '',
  size = 'md',
  showText = true,
  textClass = '',
  id,
} = Astro.props;

const pixelSize = typeof size === 'number' ? size : size === 'sm' ? 26 : size === 'lg' ? 42 : 32;
---
<a id={id} href={path('/')} class={`inline-flex items-center gap-3 group ${className}`} aria-label="Novand home">
  <svg
    class="shrink-0 transition-transform group-hover:scale-105 duration-200"
    width={pixelSize}
    height={pixelSize}
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="novand-circuit-gradient" x1="20%" y1="100%" x2="90%" y2="20%">
        <stop offset="0%" stop-color="#06B6D4" />
        <stop offset="45%" stop-color="#0EA5E9" />
        <stop offset="100%" stop-color="#10B981" />
      </linearGradient>
    </defs>

    <!-- Architectural Frame: House Roof, Left Wall & Bottom Base -->
    <path
      d="M 85 42 L 50 18 L 19 42 L 19 70 L 48 70"
      stroke="currentColor"
      stroke-width="5.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Centered 4-Pane Window -->
    <rect x="42.5" y="38.5" width="6" height="6" rx="0.8" fill="currentColor" />
    <rect x="51.5" y="38.5" width="6" height="6" rx="0.8" fill="currentColor" />
    <rect x="42.5" y="47.5" width="6" height="6" rx="0.8" fill="currentColor" />
    <rect x="51.5" y="47.5" width="6" height="6" rx="0.8" fill="currentColor" />

    <!-- Circuit Trace 1 (Top) -->
    <path
      d="M 29 77 L 55 77 L 76.5 51 L 78 51"
      stroke="url(#novand-circuit-gradient)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle
      cx="81.5"
      cy="51"
      r="4"
      stroke="url(#novand-circuit-gradient)"
      stroke-width="2.5"
      fill="none"
    />

    <!-- Circuit Trace 2 (Middle) -->
    <path
      d="M 44 84 L 60 84 L 74.5 68 L 78 68"
      stroke="url(#novand-circuit-gradient)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle
      cx="81.5"
      cy="68"
      r="4"
      stroke="url(#novand-circuit-gradient)"
      stroke-width="2.5"
      fill="none"
    />

    <!-- Circuit Trace 3 (Bottom) -->
    <path
      d="M 60 91 L 68 91 L 76 82.5 L 78 82.5"
      stroke="url(#novand-circuit-gradient)"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle
      cx="81.5"
      cy="82.5"
      r="4"
      stroke="url(#novand-circuit-gradient)"
      stroke-width="2.5"
      fill="none"
    />
  </svg>
  {showText && (
    <span class={`text-[0.84rem] font-bold tracking-[0.22em] uppercase ${textClass}`}>
      Novand
    </span>
  )}
</a>
