---
import { company, path } from '../../data/site';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  noindex?: boolean;
  light?: boolean;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description,
  canonical,
  image = '/og-image.png',
  imageAlt = 'Novand — Integrated Technology & Infrastructure Solutions',
  type = 'website',
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  noindex = false,
  light = false,
  jsonLd,
} = Astro.props;

// Ensure full branded title for page header and social cards
const formattedTitle = title.toLowerCase().includes('novand') ? title : `${title} — Novand`;

// Clean description (remove extra line breaks/spaces, limit to recommended length)
const cleanDescription = description.replace(/\s+/g, ' ').trim();

// Base & Origin resolution
const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://hessamashari.github.io';
const canonicalUrl = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : `https://hessamashari.github.io${Astro.url.pathname}`);

// Fully qualified Image URL for social card crawlers (LinkedIn, Twitter, Facebook, Slack)
const resolvedImagePath = image.startsWith('http') ? image : path(image);
const absoluteImageUrl = image.startsWith('http') ? image : new URL(resolvedImagePath, siteOrigin).toString();
const isPng = absoluteImageUrl.endsWith('.png');
const isSvg = absoluteImageUrl.endsWith('.svg');
const imageMimeType = isPng ? 'image/png' : isSvg ? 'image/svg+xml' : 'image/jpeg';

// Generate Breadcrumbs for JSON-LD schema
const rawBase = import.meta.env.BASE_URL || '/';
const cleanBase = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
let relativePath = Astro.url.pathname;
if (cleanBase && relativePath.startsWith(cleanBase)) {
  relativePath = relativePath.slice(cleanBase.length);
}
const pathSegments = relativePath.split('/').filter(Boolean);

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: new URL(path('/'), siteOrigin).toString(),
  },
];

let accumulatedPath = '';
pathSegments.forEach((segment, index) => {
  accumulatedPath += `/${segment}`;
  const isLast = index === pathSegments.length - 1;
  const name = isLast
    ? title.replace(/\s*—\s*Novand.*$/i, '').trim()
    : segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' ');

  breadcrumbItems.push({
    '@type': 'ListItem',
    position: index + 2,
    name,
    item: new URL(path(accumulatedPath), siteOrigin).toString(),
  });
});

// Organization and WebSite Schema
const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}/#organization`,
      name: company.name,
      url: new URL(path('/'), siteOrigin).toString(),
      logo: new URL(path('/favicon.svg'), siteOrigin).toString(),
      email: company.email,
      telephone: company.phone,
      description: company.positioning,
      address: {
        '@type': 'PostalAddress',
        name: company.address,
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Customer Support & Sales',
        email: company.email,
        telephone: company.phone,
        availableLanguage: ['English'],
      },
      knowsAbout: [
        'Network Infrastructure',
        'Enterprise IT Systems',
        'Linux Administration',
        'CCTV & Surveillance',
        'Smart Building Automation',
        'Audio & Integrated Power Systems',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      url: new URL(path('/'), siteOrigin).toString(),
      name: 'Novand',
      description: 'Integrated Technology & Infrastructure Solutions',
      publisher: {
        '@id': `${siteOrigin}/#organization`,
      },
      inLanguage: 'en-US',
    },
    ...(breadcrumbItems.length > 1
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonicalUrl}#breadcrumbs`,
            itemListElement: breadcrumbItems,
          },
        ]
      : []),
    ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ],
};
---

<!-- Core Search Engine Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={cleanDescription} />
<meta name="keywords" content="network infrastructure, enterprise IT, Linux administration, surveillance, CCTV, smart building automation, technology consulting, infrastructure engineering, Novand" />
<meta name="author" content="Novand" />
<meta name="publisher" content="Novand" />
<link rel="canonical" href={canonicalUrl} />

<!-- Robots & Indexing -->
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<meta
  name="googlebot"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>

<!-- Open Graph Meta Tags (Facebook, LinkedIn, Slack, Discord) -->
<meta property="og:site_name" content="Novand" />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={cleanDescription} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:image:secure_url" content={absoluteImageUrl} />
<meta property="og:image:type" content={imageMimeType} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && section && (
  <meta property="article:section" content={section} />
)}
{type === 'article' && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={cleanDescription} />
<meta name="twitter:image" content={absoluteImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Theme & Visual Branding -->
<meta name="theme-color" content={light ? '#f6f3ee' : '#141210'} />
<meta name="application-name" content="Novand" />
<meta name="apple-mobile-web-app-title" content="Novand" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

<!-- Structured Data (Schema.org JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
